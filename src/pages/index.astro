---
import Base from '../layouts/Base.astro';
import BookIntro from '../components/BookIntro.astro';
import Testimonial from '../components/Testimonial.astro';
import SectionLabel from '../components/SectionLabel.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Directed Edges" description="Design system consulting agency led by Nathan Curtis providing advisory coaching, consulting projects, and embedded staff augmentation.">
  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-10">
    <h1 class="text-4xl sm:text-5xl leading-tight mb-6">Design systems that deliver today—and adapt for what AI demands tomorrow.</h1>
    <p class="text-lg text-muted mb-4">
      <a href={`${base}/nathan-curtis`}>Nathan Curtis</a> has spent 20 years architecting design systems at scale—defining the patterns, tokens, and component models that enterprise teams rely on. Through 100+ engagements, 100+ conference talks and workshops—including emceeing Clarity in 2018 and 2022—and writing read millions of times, he's shaped how the industry builds and operates systems.
    </p>
    <p class="text-lg text-muted mb-6">
      Now, as design systems become the structured foundation that AI-driven product development depends on, Directed Edges helps teams evolve their architecture, operations, and strategy for what's next.
    </p>
    <BookIntro />
  </section>

<!-- Services -->
  <section class="max-w-3xl mx-auto px-6 py-10">
    <SectionLabel label="Consulting services" />
    <p class="text-muted mb-10">We tailor services to what you get and how you'd like to work together to deliver the value and impact you need.</p>

    <div class="grid sm:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg mb-2"><a href={`${base}/advisory`}>Advisory</a></h3>
        <p class="text-sm text-muted">Collaborative sessions supported by async consulting to refine architecture, operations and strategy.</p>
      </div>
      <div>
        <h3 class="text-lg mb-2">Architecture</h3>
        <p class="text-sm text-muted">Tackle challenges like design tokens, component design and production, composition and library ecosystems.</p>
      </div>
      <div>
        <h3 class="text-lg mb-2">Leadership</h3>
        <p class="text-sm text-muted">Augment your team with a seasoned leader to drive strategy, develop staff, guide architecture and manage work.</p>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="max-w-3xl mx-auto px-6">
    <Testimonial
      quote="Working with Nathan is to have a design system encyclopedia and cheat sheet rolled into one."
      name="Jules Forrest"
      role="Director, Design Systems at Credit Karma"
      image={`${base}/images/jules-forrest.png`}
    />
  </section>

  <!-- Experience -->
  <section class="max-w-3xl mx-auto px-6 py-10">
    <SectionLabel label="Experience" />
    <p class="text-muted mb-6">Trusted by design system teams of all sizes from leading multi-team enterprise programs to system-teams-of-one.</p>

    <Testimonial
      quote="We've been super lucky to work with Nathan at Automattic."
      name="John Maeda"
      role="Head of Computational Design and Inclusion at Automattic"
      image={`${base}/images/john-maeda.png`}
    />
  </section>

</Base>
