---
interface Props {
  quote: string;
  name: string;
  role: string;
}

const { quote, name, role } = Astro.props;
---

<blockquote class="border-l-4 border-border pl-6 py-2 my-12">
  <p class="text-lg italic text-muted">&ldquo;{quote}&rdquo;</p>
  <footer class="mt-3 text-sm">
    <span class="font-semibold">{name}</span><span class="text-muted">, {role}</span>
  </footer>
</blockquote>
