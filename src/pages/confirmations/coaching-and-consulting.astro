---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
---

<Base title="Directed Edges" description="Coaching and consulting starter package confirmation.">
  <div class="max-w-3xl mx-auto px-6 pt-20 pb-16">
    <SectionLabel label="Coaching and consulting" />
    <h1 class="text-4xl sm:text-5xl leading-tight mb-6">Starter Package Confirmation</h1>

    <p class="text-lg text-muted mb-6">We look forward to working with you!</p>

    <p class="text-muted mb-4">For our 15 minute planning session, consider coming prepared with:</p>
    <ul class="list-disc list-inside space-y-2 text-muted mb-8">
      <li>Topics you are most likely to use sessions for</li>
      <li>Stakeholders you plan to attend</li>
      <li>Proposed dates and times for each, with a few alternatives</li>
      <li>Questions about how &ldquo;Coaching and consulting&rdquo; works</li>
    </ul>

    <p class="text-muted">If you have questions prior to our session, feel free to contact Nathan at <a href="mailto:nathan@directededges.com">nathan@directededges.com</a>.</p>
  </div>
</Base>
