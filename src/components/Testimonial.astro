---
interface Props {
  quote: string;
  name: string;
  role: string;
  image?: string;
}

const { quote, name, role, image } = Astro.props;
---

<blockquote class="border-l-4 border-border pl-6 py-2 my-12">
  <p class="text-lg italic text-muted">&ldquo;{quote}&rdquo;</p>
  <footer class="mt-4 flex items-center gap-3 text-sm">
    {image && <img src={image} alt={name} class="w-10 h-10 rounded-full object-cover shrink-0" />}
    <div>
      <span class="font-semibold">{name}</span><span class="text-muted">, {role}</span>
    </div>
  </footer>
</blockquote>
